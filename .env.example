# QuartierAlert - Variables d'environnement (exemple)
# Copiez ce fichier en .env et complétez avec vos valeurs

# Serveur
PORT=3000

# Supabase
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_ANON_KEY=votre_cle_anon_publique
# Uniquement côté serveur si nécessaire
SUPABASE_SERVICE_ROLE_KEY=votre_cle_service_role

# IA (Gemini)
GEMINI_API_KEY=votre_cle_gemini

# Environnement
NODE_ENV=development
