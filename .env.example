# Copier ce fichier vers .env et renseigner les valeurs localement.
# Ne jamais committer .env. Ne jamais placer ces secrets dans frontend/.

# Serveur
PORT=3000
NODE_ENV=development
# Origines autorisées, séparées par des virgules. Exemple : http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Supabase — à créer dans le tableau de bord du projet Supabase.
# L’URL et la clé anon sont utilisées côté serveur pour les opérations
# limitées par les politiques RLS. La clé anon peut aussi être lue par
# le navigateur plus tard ; elle n’est pas un secret d’administration.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Réservée au backend. Ne jamais l’exposer au frontend, ni la mettre
# dans une variable préfixée pour le navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# Gemini — backend uniquement. L’application doit démarrer sans cette clé.
GEMINI_API_KEY=
